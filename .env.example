# BusinessBuddy environment variables (names only; copy to .env and fill in real values).
# .env is listed in .gitignore and must never be committed.

# PostgreSQL connection (database name is always businessbuddy_db)
DB_USERNAME=
DB_PASSWORD=

# First Administrator account, created at start-up if no Administrator exists
BUSINESSBUDDY_ADMIN_EMAIL=
BUSINESSBUDDY_ADMIN_PASSWORD=

# Optional for the "local" profile only
# BUSINESSBUDDY_DEMO_DATA=true
# BUSINESSBUDDY_DEMO_PASSWORD=
# BUSINESSBUDDY_DATA_DIR=./data/postgres
